# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Anthropic console. Leave empty and the chat shows "assistant unavailable".
ANTHROPIC_API_KEY=
# OpenAI platform. Embeds curriculum questions; leave empty and the agent answers without curriculum search.
OPENAI_API_KEY=
# Supabase project settings > API Keys > Secret. Only for `npm run ingest`; never used by the app.
SUPABASE_SECRET_KEY=
